From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Telegram Expert <dev@telegram.org>
Date: Sun, 24 May 2026 23:00:00 +0300
Subject: [PATCH] camera2: fix A/V sync via strict CFR negotiation and support 60 fps

---
 .../messenger/camera/Camera2Session.java      | 87 ++++++++++++++++++-
 1 file changed, 83 insertions(+), 4 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/camera/Camera2Session.java b/TMessagesProj/src/main/java/org/telegram/messenger/camera/Camera2Session.java
index e1a2b3c..f4d5e6a 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/camera/Camera2Session.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/camera/Camera2Session.java
@@ -488,11 +488,14 @@ public class Camera2Session {
             captureRequestBuilder.set(CaptureRequest.FLASH_MODE, flashing ? (recordingVideo ? CaptureRequest.FLASH_MODE_TORCH : CaptureRequest.FLASH_MODE_SINGLE) : CaptureRequest.FLASH_MODE_OFF);
 
             if (recordingVideo) {
-                captureRequestBuilder.set(CaptureRequest.CONTROL_AE_TARGET_FPS_RANGE, new Range<Integer>(30, 60));
+                captureRequestBuilder.set(CaptureRequest.CONTROL_AE_MODE, CameraMetadata.CONTROL_AE_MODE_ON);
                 captureRequestBuilder.set(CaptureRequest.CONTROL_CAPTURE_INTENT, CaptureRequest.CONTROL_CAPTURE_INTENT_VIDEO_RECORD);
+                captureRequestBuilder.set(CaptureRequest.CONTROL_AE_TARGET_FPS_RANGE, selectOptimalCfrFpsRange());
+                applyStabilizationMode(captureRequestBuilder);
+                applyVideoFocusMode(captureRequestBuilder);
             }
 
             if (zoomRatioRange != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
@@ -530,6 +533,82 @@ public class Camera2Session {
         }
     }
 
+    private volatile int currentRecordingFps = 30;
+
+    public int getCurrentRecordingFps() {
+        return currentRecordingFps;
+    }
+
+    @NonNull
+    private Range<Integer> selectOptimalCfrFpsRange() {
+        if (cameraCharacteristics == null) {
+            currentRecordingFps = 30;
+            return new Range<>(30, 30);
+        }
+        Range<Integer>[] availableRanges = cameraCharacteristics.get(CameraCharacteristics.CONTROL_AE_AVAILABLE_TARGET_FPS_RANGES);
+        if (availableRanges == null || availableRanges.length == 0) {
+            currentRecordingFps = 30;
+            return new Range<>(30, 30);
+        }
+
+        // 1. Поиск идеального фиксированного 60 FPS (CFR)
+        for (Range<Integer> range : availableRanges) {
+            if (range != null && range.getLower() == 60 && range.getUpper() == 60) {
+                currentRecordingFps = 60;
+                FileLog.d("Camera2Session: strict 60 FPS CFR selected");
+                return range;
+            }
+        }
+
+        // 2. Поиск эталонного фиксированного 30 FPS (CFR для устранения дрифта аудио)
+        for (Range<Integer> range : availableRanges) {
+            if (range != null && range.getLower() == 30 && range.getUpper() == 30) {
+                currentRecordingFps = 30;
+                FileLog.d("Camera2Session: strict 30 FPS CFR selected");
+                return range;
+            }
+        }
+
+        // 3. Fallback: поиск минимального диапазона с наименьшей дельтой для минимизации VFR
+        Range<Integer> bestCandidate = availableRanges[0];
+        int minDelta = Integer.MAX_VALUE;
+        for (Range<Integer> range : availableRanges) {
+            if (range == null) continue;
+            int delta = range.getUpper() - range.getLower();
+            if (range.getUpper() >= 30 && delta < minDelta) {
+                minDelta = delta;
+                bestCandidate = range;
+            }
+        }
+        currentRecordingFps = bestCandidate.getUpper();
+        FileLog.w("Camera2Session: strict CFR not supported by HAL, selected best range: " + bestCandidate);
+        return bestCandidate;
+    }
+
+    private void applyStabilizationMode(CaptureRequest.Builder builder) {
+        int[] oisModes = cameraCharacteristics.get(CameraCharacteristics.LENS_INFO_AVAILABLE_OPTICAL_STABILIZATION);
+        if (oisModes != null) {
+            for (int mode : oisModes) {
+                if (mode == CameraMetadata.LENS_OPTICAL_STABILIZATION_MODE_ON) {
+                    builder.set(CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE, CameraMetadata.LENS_OPTICAL_STABILIZATION_MODE_ON);
+                    builder.set(CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE, CameraMetadata.CONTROL_VIDEO_STABILIZATION_MODE_OFF);
+                    return;
+                }
+            }
+        }
+        int[] eisModes = cameraCharacteristics.get(CameraCharacteristics.CONTROL_AVAILABLE_VIDEO_STABILIZATION_MODES);
+        if (eisModes != null) {
+            for (int mode : eisModes) {
+                if (mode == CameraMetadata.CONTROL_VIDEO_STABILIZATION_MODE_ON) {
+                    builder.set(CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE, CameraMetadata.CONTROL_VIDEO_STABILIZATION_MODE_ON);
+                    builder.set(CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE, CameraMetadata.LENS_OPTICAL_STABILIZATION_MODE_OFF);
+                    return;
+                }
+            }
+        }
+    }
+
+    private void applyVideoFocusMode(CaptureRequest.Builder builder) {
+        int[] afModes = cameraCharacteristics.get(CameraCharacteristics.CONTROL_AF_AVAILABLE_MODES);
+        if (afModes != null) {
+            for (int mode : afModes) {
+                if (mode == CameraMetadata.CONTROL_AF_MODE_CONTINUOUS_VIDEO) {
+                    builder.set(CaptureRequest.CONTROL_AF_MODE, CameraMetadata.CONTROL_AF_MODE_CONTINUOUS_VIDEO);
+                    return;
+                }
+            }
+        }
+    }
