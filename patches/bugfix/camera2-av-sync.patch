+    private Range<Integer> selectOptimalCfrFpsRange() {
+        if (cameraCharacteristics == null) return new Range<>(30, 30);
+        Range<Integer>[] ranges = cameraCharacteristics.get(CameraCharacteristics.CONTROL_AE_AVAILABLE_TARGET_FPS_RANGES);
+        if (ranges == null || ranges.length == 0) return new Range<>(30, 30);
+        for (Range<Integer> range : ranges) {
+            if (range != null && range.getLower() == 60 && range.getUpper() == 60) return range;
+        }
+        for (Range<Integer> range : ranges) {
+            if (range != null && range.getLower() == 30 && range.getUpper() == 30) return range;
+        }
+        return new Range<>(30, 30);
+    }
+    private void applyStabilizationMode(CaptureRequest.Builder builder) {
+        if (cameraCharacteristics == null) return;
+        int[] ois = cameraCharacteristics.get(CameraCharacteristics.LENS_INFO_AVAILABLE_OPTICAL_STABILIZATION);
+        if (ois != null) {
+            for (int mode : ois) {
+                if (mode == CameraMetadata.LENS_OPTICAL_STABILIZATION_MODE_ON) {
+                    builder.set(CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE, CameraMetadata.LENS_OPTICAL_STABILIZATION_MODE_ON);
+                    builder.set(CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE, CameraMetadata.CONTROL_VIDEO_STABILIZATION_MODE_OFF);
+                    return;
+                }
+            }
+        }
+        int[] eis = cameraCharacteristics.get(CameraCharacteristics.CONTROL_AVAILABLE_VIDEO_STABILIZATION_MODES);
+        if (eis != null) {
+            for (int mode : eis) {
+                if (mode == CameraMetadata.CONTROL_VIDEO_STABILIZATION_MODE_ON) {
+                    builder.set(CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE, CameraMetadata.CONTROL_VIDEO_STABILIZATION_MODE_ON);
+                    builder.set(CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE, CameraMetadata.LENS_OPTICAL_STABILIZATION_MODE_OFF);
+                    return;
+                }
+            }
+        }
+    }
+    private void applyVideoFocusMode(CaptureRequest.Builder builder) {
+        if (cameraCharacteristics == null) return;
+        builder.set(CaptureRequest.CONTROL_AF_MODE, CameraMetadata.CONTROL_AF_MODE_CONTINUOUS_VIDEO);
+    }
